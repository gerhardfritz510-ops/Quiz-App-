<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<title>Quiz Generator App</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<style>
body { font-family: Arial, sans-serif; background-color: #e6f2ff; margin:0; padding:0; display:flex; flex-direction:column; align-items:center;}
header { color:white; width:100%; text-align:center; padding:16px 0; font-size:22px; box-shadow:0 4px 6px rgba(0,0,0,0.1);}
.container { max-width:480px; width:95%; margin-top:10px; display:flex; flex-direction:column; align-items:stretch;}
.card { background-color:white; border-radius:15px; box-shadow:0 6px 12px rgba(0,0,0,0.1); padding:16px; margin-bottom:15px;}
.card h2 { margin-top:0; font-size:18px;}
input, button, select, textarea { display:block; margin:5px 0 12px; padding:12px; border-radius:12px; border:1px solid #ccc; width:100%; font-size:16px; box-sizing:border-box;}
button { background-color:#2e8b57; color:white; border:none; cursor:pointer; font-size:16px; touch-action: manipulation; }
button:hover { background-color:#256d45;}
.result { font-size:18px; text-align:center; margin-top:10px; font-weight:bold; }
.progress { height:12px; width:100%; background:#ccc; border-radius:6px; overflow:hidden; margin-bottom:10px;}
.progress-bar { height:100%; width:0%; background:#2e8b57; transition:width 0.3s; text-align:center; color:white; line-height:12px; font-size:10px;}
img { max-width:100%; border-radius:10px; margin:10px 0;}
video { max-width:100%; border-radius:10px; margin:10px 0;}
textarea { resize: vertical; min-height:50px; }
.drop-zone { border:2px dashed #ccc; padding:15px; text-align:center; border-radius:10px; cursor:pointer; margin-bottom:10px; font-size:14px;}
.drop-zone.dragover { border-color:#2e8b57; background-color:#f0fff0;}
</style>
</head>
<body>
<header id="appHeader">Quiz Generator App</header>
<div class="container">

<!-- Quiz Auswahl -->
<div class="card">
<h2>Quiz auswählen</h2>
<select id="quizSelect"></select>
<input type="color" id="quizColor" value="#2e8b57">
<button id="loadQuizBtn">Quiz laden</button>
<button id="deleteQuizBtn">Quiz löschen</button>
<button id="exportQuizBtn">Quiz exportieren</button>
<input type="file" id="importFile" style="display:none;">
<button id="importQuizBtn">Quiz importieren</button>
</div>

<!-- Neues Quiz erstellen -->
<div class="card">
<h2>Neues Quiz erstellen</h2>
<input type="text" id="newQuizName" placeholder="Name des Quizzes">
<input type="color" id="newQuizColor" value="#2e8b57">
<button id="createQuizBtn">Quiz erstellen</button>
</div>

<!-- Frage erstellen -->
<div class="card" id="questionCreator" style="display:none;">
<h2>Frage erstellen</h2>
<input type="text" id="questionText" placeholder="Frage eingeben">
<button id="speechQuestionBtn"> Spracheingabe Frage</button>

<textarea id="choicesText" placeholder="Antworten, durch Komma getrennt"></textarea>
<button id="speechChoicesBtn"> Spracheingabe Antworten</button>

<input type="number" id="correctIndex" placeholder="Index der richtigen Antwort (0 = erste)">
<input type="text" id="hintText" placeholder="Hinweis (optional)">
<button id="speechHintBtn"> Spracheingabe Hinweis</button>

<label>Bild hochladen (Drag & Drop oder Klick, max 5MB)</label>
<div id="imageDrop" class="drop-zone">Bild hierher ziehen oder klicken</div>

<label>Video hochladen (Drag & Drop oder Klick, MP4/WebM, max 20MB)</label>
<div id="videoDrop" class="drop-zone">Video hierher ziehen oder klicken</div>

<button id="addQuestionBtn">Frage hinzufügen</button>
</div>

<!-- Quiz starten -->
<div class="card" id="quizPlayCard" style="display:none;">
<button id="startQuizBtn">Quiz starten / neu starten</button>
<div class="progress"><div class="progress-bar" id="progressBar"></div></div>
</div>

<div id="quizArea" class="card"></div>
<div id="result" class="result"></div>
</div>

<script>
let quizzes = JSON.parse(localStorage.getItem('quizzes')) || {};
let currentQuiz = null;
let currentQuestions = [];
let current = 0;
let score = 0;
let uploadedImage = '';
let uploadedVideo = '';
let speaking = false;

function refreshQuizSelect(){
  const sel = document.getElementById('quizSelect'); sel.innerHTML='';
  Object.keys(quizzes).forEach(name=>{ const opt=document.createElement('option'); opt.value=name; opt.textContent=name; sel.appendChild(opt); });
}
refreshQuizSelect();

// ================= Touch-optimierte Button Events =================
document.getElementById('createQuizBtn').addEventListener('click', createQuiz);
document.getElementById('loadQuizBtn').addEventListener('click', loadQuiz);
document.getElementById('deleteQuizBtn').addEventListener('click', deleteQuiz);
document.getElementById('addQuestionBtn').addEventListener('click', addQuestion);
document.getElementById('startQuizBtn').addEventListener('click', startQuiz);
document.getElementById('speechQuestionBtn').addEventListener('click', ()=>startSpeech('questionText'));
document.getElementById('speechChoicesBtn').addEventListener('click', ()=>startSpeech('choicesText'));
document.getElementById('speechHintBtn').addEventListener('click', ()=>startSpeech('hintText'));
document.getElementById('exportQuizBtn').addEventListener('click', exportQuiz);
document.getElementById('importQuizBtn').addEventListener('click', ()=>document.getElementById('importFile').click());
document.getElementById('importFile').addEventListener('change', importQuiz);

// ================= Quiz & Fragen Funktionen =================
function createQuiz(){
  const name=document.getElementById('newQuizName').value.trim();
  const color=document.getElementById('newQuizColor').value;
  if(!name){alert("Bitte einen Namen eingeben!"); return;}
  if(quizzes[name]){alert("Quiz existiert bereits!"); return;}
  quizzes[name]={color: color, questions: []};
  localStorage.setItem('quizzes', JSON.stringify(quizzes));
  refreshQuizSelect(); document.getElementById('newQuizName').value='';
  alert("Quiz erstellt! Jetzt Fragen hinzufügen.");
  document.getElementById('questionCreator').style.display='block';
  document.getElementById('quizPlayCard').style.display='block';
  currentQuiz=name; currentQuestions=quizzes[name].questions;
  document.getElementById('appHeader').style.backgroundColor=color;
}

function loadQuiz(){
  const name=document.getElementById('quizSelect').value; if(!name){alert("Bitte ein Quiz auswählen!"); return;}
  currentQuiz=name; currentQuestions=quizzes[name].questions;
  document.getElementById('appHeader').style.backgroundColor=quizzes[name].color;
  document.getElementById('questionCreator').style.display='block';
  document.getElementById('quizPlayCard').style.display='block';
  document.getElementById('quizColor').value=quizzes[name].color;
}

function deleteQuiz(){
  const name=document.getElementById('quizSelect').value; if(!name){alert("Bitte ein Quiz auswählen!"); return;}
  if(confirm(`Quiz "${name}" wirklich löschen?`)){
    delete quizzes[name]; localStorage.setItem('quizzes', JSON.stringify(quizzes)); refreshQuizSelect();
    currentQuiz=null; currentQuestions=[]; alert("Quiz gelöscht!");
    document.getElementById('questionCreator').style.display='none';
    document.getElementById('quizPlayCard').style.display='none';
    document.getElementById('appHeader').style.backgroundColor="#2e8b57";
  }
}

function addQuestion(){
  const question=document.getElementById('questionText').value.trim();
  const choices=document.getElementById('choicesText').value.split(',').map(c=>c.trim());
  const correct=parseInt(document.getElementById('correctIndex').value);
  const hint=document.getElementById('hintText').value.trim();
  if(!question || choices.length<2 || isNaN(correct) || correct<0 || correct>=choices.length){alert("Bitte alle Felder korrekt ausfüllen."); return;}
  currentQuestions.push({question, choices, correct, hint, image:uploadedImage, video:uploadedVideo});
  quizzes[currentQuiz].questions=currentQuestions;
  quizzes[currentQuiz].color=document.getElementById('quizColor').value;
  localStorage.setItem('quizzes', JSON.stringify(quizzes));
  alert("Frage hinzugefügt!"); document.getElementById('questionText').value=''; document.getElementById('choicesText').value=''; document.getElementById('correctIndex').value=''; document.getElementById('hintText').value=''; uploadedImage=''; uploadedVideo='';
}

function startQuiz(){ if(currentQuestions.length===0){alert("Keine Fragen!"); return;} current=0; score=0; document.getElementById('result').textContent=''; updateProgress(); showQuestion(); }

function speak(text){
  if('speechSynthesis' in window){
    if(speaking) window.speechSynthesis.cancel();
    speaking=true;
    const voices=window.speechSynthesis.getVoices();
    const germanVoice=voices.find(v=>v.lang.startsWith('de') && v.name.toLowerCase().includes('google')) || voices.find(v=>v.lang.startsWith('de')) || voices[0];
    const parts=text.split('. ').map(p=>p.trim()).filter(p=>p);
    let i=0;
    function speakNext(){ if(i>=parts.length){ speaking=false; return; }
      const u=new SpeechSynthesisUtterance(parts[i]); u.voice=germanVoice; u.rate=0.85+Math.random()*0.15; u.pitch=1+(Math.random()*0.2-0.1); u.lang='de-DE';
      u.onend=()=>{ i++; setTimeout(speakNext,400+Math.random()*100); }; window.speechSynthesis.speak(u);
    } speakNext();
  }
}

function showQuestion(){
  const quizDiv=document.getElementById('quizArea'); quizDiv.innerHTML='';
  if(current>=currentQuestions.length){ const resultText=`Quiz beendet! Dein Ergebnis: ${score} von ${currentQuestions.length}`;
    document.getElementById('result').textContent=resultText; speak(resultText); updateProgress(); return; }

  const q=currentQuestions[current]; const card=document.createElement('div'); card.className='card';
  card.innerHTML=`<h2>${current+1}. ${q.question}</h2>`;
  if(q.image){ const img=document.createElement('img'); img.src=q.image; card.appendChild(img);}
  if(q.video){ if(q.video.startsWith('data:video')){ const vid=document.createElement('video'); vid.src=q.video; vid.controls=true; card.appendChild(vid); } }

  const letters=['a','b','c','d','e','f','g','h'];
  q.choices.forEach((choice,i)=>{
    const btn=document.createElement('button'); btn.textContent=choice;
    btn.addEventListener('click', ()=>checkAnswer(i,btn));
    btn.addEventListener('touchstart', ()=>checkAnswer(i,btn));
    card.appendChild(btn);
  });
  if(q.hint){ const hintDiv=document.createElement('div'); hintDiv.style.fontStyle='italic'; hintDiv.style.marginTop='10px'; hintDiv.textContent=`Hinweis: ${q.hint}`; card.appendChild(hintDiv); }

  quizDiv.appendChild(card);

  let speakText=`${q.question}. `; q.choices.forEach((c,i)=>{ speakText+=`${letters[i]}) ${c}. `; }); if(q.hint) speakText+=`Hinweis: ${q.hint}.`; speak(speakText);
  updateProgress();
}

function checkAnswer(selected,btn){ const buttons=btn.parentNode.querySelectorAll('button'); buttons.forEach((b,i)=>{ if(i===currentQuestions[current].correct){ b.style.backgroundColor='#2e8b57'; b.style.color='white'; }else{b.style.backgroundColor='#c0392b';b.style.color='white';} b.disabled=true; });
if(selected===currentQuestions[current].correct) score++; current++; setTimeout(()=>showQuestion(),1000); }

function updateProgress(){ const bar=document.getElementById('progressBar'); if(currentQuestions.length===0){bar.style.width='0%'; bar.textContent=''; return;} const percent=Math.round((current/currentQuestions.length)*100); bar.style.width=`${percent}%`; bar.textContent=`${percent}%`; }

function startSpeech(inputId){ const SpeechRecognition=window.SpeechRecognition || window.webkitSpeechRecognition; if(!SpeechRecognition){ alert("Spracheingabe nicht unterstützt!"); return; } const recognition=new SpeechRecognition(); recognition.lang='de-DE'; recognition.interimResults=false; recognition.maxAlternatives=1; recognition.onresult=function(e){ document.getElementById(inputId).value=e.results[0][0].transcript; }; recognition.onerror=function(){ alert("Spracheingabe blockiert!"); }; recognition.start(); }

function setupDragDrop(){
  const imageDiv=document.getElementById('imageDrop'); const videoDiv=document.getElementById('videoDrop');
  function handleFiles(files,type){ const file=files[0]; if(!file) return; if(type==='image' && file.size>5*1024*1024){alert("Bild >5MB!"); return;} if(type==='video' && file.size>20*1024*1024){alert("Video >20MB!"); return;} const reader=new FileReader(); reader.onload=function(e){ if(type==='image') uploadedImage=e.target.result; else uploadedVideo=e.target.result; alert(type.toUpperCase()+" hochgeladen!"); }; reader.readAsDataURL(file); }
  [[imageDiv,'image'],[videoDiv,'video']].forEach(([div,type])=>{
    div.ondragover=e=>{ e.preventDefault(); div.classList.add('dragover'); };
    div.ondragleave=e=>{ e.preventDefault(); div.classList.remove('dragover'); };
    div.ondrop=e=>{ e.preventDefault(); div.classList.remove('dragover'); handleFiles(e.dataTransfer.files,type); };
    div.onclick=e=>{ e.stopPropagation(); const inp=document.createElement('input'); inp.type='file'; inp.accept=type==='image'?'image/*':'video/mp4,video/webm'; inp.onchange=e=>handleFiles(e.target.files,type); inp.click(); };
  });
}
setupDragDrop();

// ================= Export / Import =================
function exportQuiz(){ if(!currentQuiz){alert("Kein Quiz geladen."); return;} const dataStr="data:text/json;charset=utf-8,"+encodeURIComponent(JSON.stringify(quizzes[currentQuiz])); const dl=document.createElement('a'); dl.setAttribute("href",dataStr); dl.setAttribute("download",currentQuiz+".json"); dl.click();}
function importQuiz(event){ const file=event.target.files[0]; if(!file) return; const reader=new FileReader(); reader.onload=function(e){ try{ const data=JSON.parse(e.target.result); const name=data.name||file.name.replace('.json',''); quizzes[name]=data; localStorage.setItem('quizzes',JSON.stringify(quizzes)); refreshQuizSelect(); alert("Quiz importiert!"); }catch(err){alert("Fehler beim Importieren!");} }; reader.readAsText(file);}
</script>
</body>
</html>
